# One-shot scan whose JSON report is written to /var/lib/infra-probe/report.json.
# Prerequisite: a system user "infra-probe" that belongs to the "docker" group
#   useradd --system --no-create-home --shell /usr/sbin/nologin -G docker infra-probe
[Unit]
Description=infra-probe scan
After=docker.service

[Service]
Type=oneshot
User=infra-probe
ExecStart=/usr/local/bin/infra-probe scan
StateDirectory=infra-probe
StandardOutput=truncate:/var/lib/infra-probe/report.json

# Hardening: the probe only reads, so it gets almost no privileges.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
# read-only, not "yes": compose files are often under /home/<user>/..., and the
# probe must be able to read them (it never writes there).
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service

# As an unprivileged user the probe cannot tell which process owns a listening
# port (it cannot look inside /proc/<pid>/fd of other users), nor read the
# crontabs of the users: the report says so in its "notes". Both are optional.
# To see the process of each port, uncomment the two lines below (CAP_SYS_PTRACE
# is a powerful capability, even though the probe only reads), and replace the
# empty CapabilityBoundingSet= above:
#AmbientCapabilities=CAP_SYS_PTRACE
#CapabilityBoundingSet=CAP_SYS_PTRACE

# The firewall rules (iptables, nftables) can only be listed with CAP_NET_ADMIN;
# without it the report shows ufw from its configuration files and says the
# rest is missing. CAP_NET_ADMIN also allows changing the rules: the probe only
# runs iptables-save, ip6tables-save and "nft list ruleset", but the capability
# itself is not read-only. To grant it, uncomment the three lines below and
# replace CapabilityBoundingSet= above (to grant CAP_SYS_PTRACE as well, write
# both capabilities, space separated, on one AmbientCapabilities= and one
# CapabilityBoundingSet= line). The tools talk to the kernel over netlink;
# iptables-legacy also needs CAP_NET_RAW and AF_INET.
#AmbientCapabilities=CAP_NET_ADMIN
#CapabilityBoundingSet=CAP_NET_ADMIN
#RestrictAddressFamilies=AF_UNIX AF_NETLINK
# The ufw rule files (/etc/ufw/user.rules) stay readable by root only.
